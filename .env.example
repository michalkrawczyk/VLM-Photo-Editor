# Copy to .env and fill in real values. This file must never contain real keys.

# VLM provider — at least one required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional additional providers
OPENAI_API_KEY=sk-your-openai-key-here
REPLICATE_API_TOKEN=r8_your-replicate-token-here

# Local Character Focus detector models (optional; no auto-download).
# Absolute path to an exported model file. yolo_onnx also falls back to a bundled
# infer_models/yolo/yolo26s.onnx when present, so this line is only needed to override it.
# MEDIAPIPE_MODEL_PATH=/abs/path/to/efficientdet_lite0.tflite
# YOLO_ONNX_MODEL_PATH=/abs/path/to/yolo26s.onnx
# U2NETP_MODEL_PATH=/abs/path/to/u2netp.onnx
